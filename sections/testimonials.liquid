<div class="testimonials full-width">
  <div class="testimonials__inner">
    {% if section.settings.heading != blank %}
      <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="testimonials__grid">
      {% for block in section.blocks %}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__stars">
            {% for i in (1..block.settings.rating) %}★{% endfor %}
          </div>
          <blockquote>"{{ block.settings.quote }}"</blockquote>
          <figcaption>— {{ block.settings.author }}</figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .testimonials {
    display: grid;
    grid-template-columns: var(--content-grid);
    padding: 64px 0;
  }
  .testimonials__inner {
    grid-column: 2;
    padding: 0 24px;
  }
  .testimonials__heading {
    text-align: center;
    margin-bottom: 32px;
  }
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
  }
  .testimonial {
    margin: 0;
    padding: 24px;
    border-radius: 12px;
    background: #f6f6f7;
  }
  .testimonial__stars {
    color: #f5a623;
    font-size: 1.25rem;
  }
  .testimonial blockquote {
    margin: 12px 0;
    line-height: 1.5;
  }
  .testimonial figcaption {
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Absolutely love this product!" },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Happy Customer" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}